{
  "schema": "jianying-workflow-policy/v1",
  "editor": "jianying",
  "free_only": true,
  "requires_user_srt": true,
  "requires_uisfx_selection": true,
  "autonomous_fullscreen_broll": true,
  "synchronized_presenter_window": true,
  "review_scope": "changed_ranges_of_formal_output",
  "max_automatic_repair_rounds": 2,
  "default_delivery": "4A",
  "explicit_delivery_modes": [
    "4B"
  ],
  "automatic_timeline_placement": false,
  "automatic_project_save": false,
  "automatic_final_export": false,
  "automatic_media_import": false,
  "automatic_media_replacement": false,
  "automatic_native_track_creation": false,
  "user_performs_import_and_placement": true,
  "requires_file_usability_check": true,
  "requires_full_decode": true,
  "requires_actual_alpha_samples": true,
  "requires_content_review": true,
  "requires_compatibility_evidence": true,
  "delivery_on_failed_or_unavailable_check": false,
  "replacement_requires_explicit_editor_action": true,
  "user_performs_media_replacement": true,
  "requires_asset_content_review": true,
  "requires_timeline_arrangement_review": true,
  "requires_composite_context_review": true,
  "automatic_post_import_review": false,
  "revision_and_redo_require_new_file": true,
  "requires_new_file_download_link": true,
  "preserve_previous_deliveries": true,
  "native_task_replacement_attempt_limit": 1,
  "requires_srt_source_alignment": true,
  "requires_locked_final_timebase": true,
  "requires_compatibility_config_match": true,
  "requires_continuous_high_risk_review": true,
  "requires_declared_product": true,
  "requires_final_handoff_gate": true,
  "final_handoff_script": "scripts/finalize_delivery.py",
  "handoff_links_from_verified_receipt": true,
  "requires_handoff_production_plan": true,
  "requires_final_uisfx_binding_check": true
}
